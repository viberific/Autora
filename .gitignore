# Build output
dist/
build/

# Python (the .github scripts, ui/scripts, the Spectra engine's venv)
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/
# node_modules with no trailing slash is the symlink some clones have in place of the directory (pointing at
# another clone on the same machine). `node_modules/` matches the directory only, so without this line the
# link shows up as untracked and `git add -A` puts an absolute local path back in the tree -- which is what
# broke the 0.9.284 image build: an autora-3d/node_modules symlink copied over the real directory.
node_modules
*.tsbuildinfo

# Autora runtime state
.autora/
recordings/

# Env / secrets
.env
.env.*
!.env.example

# OS
.DS_Store

# Office tools: the pinned GenOffice checkout and what is built from it
.cache/

# Spectra's renderer, fetched from the pin and patched by scripts/prepare-spectra-editor.mjs
spectra-editor/src/renderer/
spectra-editor/.prepared

# OpenCut's editor, fetched from the pin and overlaid by scripts/prepare-opencut-editor.mjs
opencut-editor/src/web/
opencut-editor/src/web-public/
opencut-editor/.prepared
gdevelop-editor/work/
gdevelop-editor/.prepared
