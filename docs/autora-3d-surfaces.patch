+    const length = hair.length * g.length * (0.8 + rand() * 0.4);
+    const seg = length / steps;
+    const tilt = new THREE.Vector3(rand() - 0.5, rand() - 0.5, rand() - 0.5).multiplyScalar(0.25 + hair.frizz * 0.5);
