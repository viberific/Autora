+  const xs = b.points.map((p) => p.x);
+  const ys = b.points.map((p) => p.y);
+  const made = a.mirror ? [stroke, mirrorStroke(stroke, a.mirror, { minX: Math.min(...xs), maxX: Math.max(...xs), minY: Math.min(...ys), maxY: Math.max(...ys) })] : [stroke];
