+          h = round * 0.9 + noise(u, v, 128) * 0.1;
+          break;
+        }
+        case 'scales': {
+          // Rows of overlapping round scales, each row half a scale along from the last.
+          const n = 6;
+          const row = Math.floor(v * n);
+          const su = u * n + (row % 2) * 0.5;
+          const sv = fract(v * n);
+          const du = fract(su) - 0.5;
+          const d = Math.hypot(du, sv) / 0.75;
